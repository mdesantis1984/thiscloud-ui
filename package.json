{
  "name": "@thiscloud/ui-aurora",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable web, hybrid, and Flutter UI foundations for Thiscloud products.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdesantis1984/thiscloud-ui.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "ui-catalog:build": "node scripts/build-ui-catalog.mjs production",
    "ui-catalog:dev-build": "node scripts/build-ui-catalog.mjs development",
    "ui-catalog:serve": "node scripts/serve-ui-catalog.mjs",
    "ui-catalog:test-server": "node scripts/test-serve-ui-catalog.mjs",
    "ui-catalog:verify": "node scripts/verify-ui-catalog.mjs",
    "ui-web:test": "pnpm ui-catalog:build && node scripts/test-ui-web-package.mjs",
    "ui-web:browser-test": "pnpm ui-web:test",
    "ui-web:pack": "pnpm ui-catalog:build && pnpm --dir packages/ui-web pack --pack-destination ../../tmp/ui-web-pack",
    "check:web": "pnpm ui-web:test && pnpm ui-catalog:verify && pnpm ui-catalog:test-server",
    "release:prepare": "pnpm ui-catalog:build && node scripts/prepare-release.mjs",
    "release:verify": "node scripts/test-release-assets.mjs",
    "deploy:verify": "node scripts/test-deployment-config.mjs",
    "check:release": "pnpm release:prepare && pnpm release:verify && pnpm deploy:verify"
  },
  "devDependencies": {
    "@thiscloud/ui-web": "workspace:*",
    "esbuild": "0.25.9",
    "javascript-obfuscator": "4.1.1",
    "playwright-core": "1.61.0"
  }
}
